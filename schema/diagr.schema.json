{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagr diagram",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "Format version the file is written in; default 1. The current one is 2; diagr upgrades older ones as it reads them, with a warning for each change"
    },
    "id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)$",
      "description": "Diagram id, used for output file names"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Accessible description of the whole diagram"
    },
    "theme": {
      "type": "string",
      "description": "Theme name or path to a theme file"
    },
    "icons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Icon folders, relative to this file"
    },
    "grid": {
      "type": "object",
      "properties": {
        "col": {
          "type": "number",
          "minimum": 1
        },
        "row": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "description": "Cell size in px"
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/group"
      }
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Grid cell [col, row]; fractions allowed; default: placed automatically"
          },
          "title": {
            "type": "string"
          },
          "sub": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Muted text under the title"
          },
          "icon": {
            "type": "string",
            "description": "Icon name from the diagram's icon folders or the core set"
          },
          "tone": {
            "type": "string",
            "description": "Tile colour for generated icons"
          },
          "junction": {
            "type": "boolean",
            "description": "A dot where edges meet (a bus); has no icon or text"
          },
          "align_x": {
            "type": "string",
            "description": "A node to line up with, one above the other: same x"
          },
          "align_y": {
            "type": "string",
            "description": "A node to line up with, side by side: same y"
          },
          "cells": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "description": "Progress cells: a list of names (shown as the caption while active) or a count"
          },
          "stack": {
            "type": "integer",
            "minimum": 1,
            "description": "Draw the icon as a stack of N"
          },
          "mark": {
            "type": "string",
            "enum": [
              "new",
              "removed",
              "changed"
            ]
          },
          "hidden": {
            "type": "boolean",
            "description": "Start hidden; a scenario can show it"
          },
          "tooltip": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A node: icon, title and sub text, centred on a grid cell"
      },
      "minProperties": 1
    },
    "edges": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?|\\(\\s*[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?(?:\\s+[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?)*\\s*\\))(?:\\s*(?:<->|-->|->)\\s*(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?|\\(\\s*[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?(?:\\s+[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?)*\\s*\\)))+(?:\\s+as\\s+[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?)?)$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "oneOf": [
              {
                "type": "string",
                "description": "The label"
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "route": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?:(up|down|left|right)(?:\\s+(\\d+(?:\\.\\d+)?)(px)?)?)$",
                      "description": "a move: up, down, left or right, with an optional length in cells or px, e.g. 'right 0.5' or 'up 40px'"
                    },
                    "description": "Moves from the start node. Moves without a length on the same axis share what is left"
                  },
                  "via": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "description": "Explicit waypoints in grid cells (escape hatch)"
                  },
                  "dashed": {
                    "type": "boolean"
                  },
                  "mark": {
                    "type": "string",
                    "enum": [
                      "new",
                      "removed",
                      "changed"
                    ]
                  },
                  "label_at": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Label position along the path, 0 to 1; default: middle of the longest segment"
                  },
                  "hidden": {
                    "type": "boolean"
                  },
                  "tooltip": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ],
            "description": "An edge: its label, or a mapping"
          },
          {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "The label"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "route": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^(?:(up|down|left|right)(?:\\s+(\\d+(?:\\.\\d+)?)(px)?)?)$",
                            "description": "a move: up, down, left or right, with an optional length in cells or px, e.g. 'right 0.5' or 'up 40px'"
                          },
                          "description": "Moves from the start node. Moves without a length on the same axis share what is left"
                        },
                        "via": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "description": "Explicit waypoints in grid cells (escape hatch)"
                        },
                        "dashed": {
                          "type": "boolean"
                        },
                        "mark": {
                          "type": "string",
                          "enum": [
                            "new",
                            "removed",
                            "changed"
                          ]
                        },
                        "label_at": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Label position along the path, 0 to 1; default: middle of the longest segment"
                        },
                        "hidden": {
                          "type": "boolean"
                        },
                        "tooltip": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "description": "An edge: its label, or a mapping"
                }
              ]
            },
            "description": "One label or mapping per edge"
          }
        ],
        "description": "Nothing, the label, a mapping for every edge the key makes, or a list with one each"
      },
      "description": "Edges. The key is 'a -> b', with optional ports 'a@bottom+10' and id 'a -> b as name'. A chain 'a -> b -> c' makes an edge per arrow, '(a b) -> c' one from each, '-->' a dashed edge and '<->' a pair, one each way, side by side"
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "params": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*)$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "required": {
                      "const": true
                    }
                  },
                  "required": [
                    "required"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "The default value, or {required: true} for a parameter every instance must set"
            },
            "description": "Text parameters, used as {name} in titles, sub text, labels, tooltips and triggers"
          },
          "groups": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*)$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/group"
            }
          },
          "nodes": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*)$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "Grid cell [col, row]; fractions allowed; default: placed automatically"
                },
                "title": {
                  "type": "string"
                },
                "sub": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ],
                  "description": "Muted text under the title"
                },
                "icon": {
                  "type": "string",
                  "description": "Icon name from the diagram's icon folders or the core set"
                },
                "tone": {
                  "type": "string",
                  "description": "Tile colour for generated icons"
                },
                "junction": {
                  "type": "boolean",
                  "description": "A dot where edges meet (a bus); has no icon or text"
                },
                "align_x": {
                  "type": "string",
                  "description": "A node to line up with, one above the other: same x"
                },
                "align_y": {
                  "type": "string",
                  "description": "A node to line up with, side by side: same y"
                },
                "cells": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "description": "Progress cells: a list of names (shown as the caption while active) or a count"
                },
                "stack": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Draw the icon as a stack of N"
                },
                "mark": {
                  "type": "string",
                  "enum": [
                    "new",
                    "removed",
                    "changed"
                  ]
                },
                "hidden": {
                  "type": "boolean",
                  "description": "Start hidden; a scenario can show it"
                },
                "tooltip": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "description": "A node: icon, title and sub text, centred on a grid cell"
            },
            "minProperties": 1
          },
          "edges": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(?:(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?|\\(\\s*[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?(?:\\s+[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?)*\\s*\\))(?:\\s*(?:<->|-->|->)\\s*(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?|\\(\\s*[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?(?:\\s+[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?(?:@(?:left|right|top|bottom)(?:[+-]\\d+(?:\\.\\d+)?)?)?)*\\s*\\)))+(?:\\s+as\\s+[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?)?)$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "The label"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "route": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^(?:(up|down|left|right)(?:\\s+(\\d+(?:\\.\\d+)?)(px)?)?)$",
                            "description": "a move: up, down, left or right, with an optional length in cells or px, e.g. 'right 0.5' or 'up 40px'"
                          },
                          "description": "Moves from the start node. Moves without a length on the same axis share what is left"
                        },
                        "via": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "description": "Explicit waypoints in grid cells (escape hatch)"
                        },
                        "dashed": {
                          "type": "boolean"
                        },
                        "mark": {
                          "type": "string",
                          "enum": [
                            "new",
                            "removed",
                            "changed"
                          ]
                        },
                        "label_at": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Label position along the path, 0 to 1; default: middle of the longest segment"
                        },
                        "hidden": {
                          "type": "boolean"
                        },
                        "tooltip": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "description": "An edge: its label, or a mapping"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "oneOf": [
                          {
                            "type": "string",
                            "description": "The label"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string"
                              },
                              "route": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "pattern": "^(?:(up|down|left|right)(?:\\s+(\\d+(?:\\.\\d+)?)(px)?)?)$",
                                  "description": "a move: up, down, left or right, with an optional length in cells or px, e.g. 'right 0.5' or 'up 40px'"
                                },
                                "description": "Moves from the start node. Moves without a length on the same axis share what is left"
                              },
                              "via": {
                                "type": "array",
                                "items": {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  },
                                  "minItems": 2,
                                  "maxItems": 2
                                },
                                "description": "Explicit waypoints in grid cells (escape hatch)"
                              },
                              "dashed": {
                                "type": "boolean"
                              },
                              "mark": {
                                "type": "string",
                                "enum": [
                                  "new",
                                  "removed",
                                  "changed"
                                ]
                              },
                              "label_at": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "description": "Label position along the path, 0 to 1; default: middle of the longest segment"
                              },
                              "hidden": {
                                "type": "boolean"
                              },
                              "tooltip": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        ],
                        "description": "An edge: its label, or a mapping"
                      }
                    ]
                  },
                  "description": "One label or mapping per edge"
                }
              ],
              "description": "Nothing, the label, a mapping for every edge the key makes, or a list with one each"
            },
            "description": "Edges. The key is 'a -> b', with optional ports 'a@bottom+10' and id 'a -> b as name'. A chain 'a -> b -> c' makes an edge per arrow, '(a b) -> c' one from each, '-->' a dashed edge and '<->' a pair, one each way, side by side"
          },
          "actions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*)$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/effects"
            },
            "description": "Named lists of effects in the component's own ids, called with the instances they run on: 'pull a b' runs pull on instances a and b side by side"
          }
        },
        "additionalProperties": false,
        "description": "A reusable block of groups, nodes and edges in its own grid cells; 'instances' uses it"
      }
    },
    "instances": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)$",
            "description": "Component id"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Grid cell where the component's [0, 0] goes; default [0, 0]"
          },
          "in": {
            "type": "string",
            "description": "Group that holds the instance's outermost groups and nodes"
          },
          "with": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*)$"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "Parameter values"
          }
        },
        "additionalProperties": false,
        "required": [
          "component"
        ],
        "description": "An instance of a component; its groups, nodes and edges are named '<instance>/<id>'"
      }
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/effects"
      },
      "description": "Named lists of effects, called in a step's 'do' by their name"
    },
    "scenarios": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Name in the player's scenario picker"
          },
          "trigger": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "description": "The node the button hangs under"
              },
              "label": {
                "type": "string",
                "description": "The button's label"
              }
            },
            "additionalProperties": false,
            "required": [
              "at",
              "label"
            ],
            "description": "A button under a node that plays this scenario"
          },
          "loop": {
            "type": "boolean",
            "description": "Replay forever; the first looping scenario starts on its own when the page loads"
          },
          "ready": {
            "type": "string",
            "description": "Status line before the run"
          },
          "end": {
            "type": "string",
            "description": "Status line after the run"
          },
          "steps": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "description": "Longer explanation for the step list"
                    },
                    "at": {
                      "type": "string",
                      "description": "Node that carries the step's number badge"
                    },
                    "status": {
                      "type": "string",
                      "description": "Status line while the step plays; default: the title"
                    },
                    "focus": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "description": "Dim everything but these, and the edges between them, for the step"
                    },
                    "do": {
                      "$ref": "#/$defs/effects",
                      "description": "Effects, in order"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "title"
                  ]
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1,
                  "additionalProperties": {
                    "$ref": "#/$defs/effects"
                  },
                  "description": "'Title: [effects]', for a step with no text"
                }
              ]
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "steps"
        ]
      },
      "minProperties": 1,
      "description": "Scenarios by id; the first is the default and static output's"
    },
    "step_list": {
      "type": "boolean",
      "description": "Show numbered badges and the step list in static output (default true)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "right",
        "down"
      ],
      "description": "Which way automatically placed nodes flow"
    },
    "align": {
      "type": "boolean",
      "description": "Line up the edges of sibling boxes that nearly line up (default true)"
    },
    "layout": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "row",
            "column"
          ]
        },
        {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "enum": [
                "row",
                "column"
              ],
              "description": "row or column (default column)"
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "description": "Space between items, in px (default 24)"
            },
            "align": {
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ],
              "description": "Across the direction: start, center (default), end, or stretch to fill"
            },
            "justify": {
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "space-between",
                "space-around"
              ],
              "description": "Along the direction, for space left over: start (default), center, end, space-between or space-around"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Arrange what the box holds in a row or column, in file order, instead of by cells: row, column, or a mapping with direction, gap and align"
    },
    "views": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the view's page and images; default: the diagram's"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group and node ids to show, groups with everything inside them"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group and node ids to leave out of what include selects"
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Scenarios the view keeps; default: none"
          },
          "scenario": {
            "type": "string",
            "description": "Make it a dynamic view: show what this scenario uses, keep it, and number its edges by step"
          }
        },
        "additionalProperties": false
      },
      "description": "Parts of the diagram built as their own images and page, <id>-<view>"
    }
  },
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "$defs": {
    "effects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "'verb targets [duration]', e.g. 'draw a->b 700ms', or an action's name and its instances. Verbs: activate: Node starts working: pulsing ring, spinner badge; done: Node finished: check badge; fail: Node failed: red ring and cross; an active cell fails too; run: Node works for a while, then finishes: 'run api 800ms' is activate api 800ms, then done api; draw: Edge is used: the accent line draws along the path, showing the edge if it is hidden; flow: Follow a path: 'flow a -> b' is activate a, draw a->b, done a. A duration after a stop is how long it stays active ('flow a 600ms -> b'), '(b c)' is several stops side by side, and 'done' at the end finishes the last stop, which is otherwise left as it is; cells: Fill a node's cells one by one, or only some: 'cells n 2..4', 'cells n 3', 'cells n build..test'; spin: Rotate the node's glyph; 'spin n off' stops it; show: Reveal a hidden node, edge or group; hide: Hide a node, edge or group; focus: Dim everything except the targets and the edges between them; 'focus none' clears; wait: Pause"
          },
          {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^(?!(?:activate|done|fail|run|draw|flow|cells|spin|show|hide|focus|wait|parallel|repeat)\\b)\\S+(?:\\s+\\d+(?:\\.\\d+)?(?:ms|s))?$"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "Text that changes: 'node.sub: text', 'node.title', 'node.sub.N', 'a->b.label' or 'status', each with an optional duration ('api.sub 400ms: text'). Several in one mapping change together"
          },
          {
            "type": "object",
            "required": [
              "parallel"
            ],
            "additionalProperties": false,
            "properties": {
              "parallel": {
                "$ref": "#/$defs/effects"
              }
            },
            "description": "Effects that play together, in lockstep"
          },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "propertyNames": {
              "pattern": "^repeat\\s+\\d+$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/effects"
            },
            "description": "'repeat 3: [...]' plays the effects 3 times; '{i}' in text is the round number"
          },
          {
            "$ref": "#/$defs/effects",
            "description": "Effects that play one after another, as one lane"
          }
        ]
      }
    },
    "group": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Shown at the bottom left of the group"
        },
        "sub": {
          "type": "string",
          "description": "Muted text after the title"
        },
        "icon": {
          "type": "string",
          "description": "Icon name, shown before the title"
        },
        "tone": {
          "type": "string",
          "description": "Theme tone: blue, teal, green, violet, amber, orange, neutral"
        },
        "at": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Top-left cell [col, row]; default: fit the member nodes and groups"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Size in cells [cols, rows]"
        },
        "title_at": {
          "type": "string",
          "enum": [
            "bottom-left",
            "top-left",
            "top",
            "bottom",
            "middle"
          ],
          "description": "Where the title goes: bottom-left (default), top-left (default for a stack), top or bottom (centred along that edge), or middle: a heading beside the box's nodes, sub below"
        },
        "layout": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "row",
                "column"
              ]
            },
            {
              "type": "object",
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "row",
                    "column"
                  ],
                  "description": "row or column (default column)"
                },
                "gap": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Space between items, in px (default 24)"
                },
                "align": {
                  "type": "string",
                  "enum": [
                    "start",
                    "center",
                    "end",
                    "stretch"
                  ],
                  "description": "Across the direction: start, center (default), end, or stretch to fill"
                },
                "justify": {
                  "type": "string",
                  "enum": [
                    "start",
                    "center",
                    "end",
                    "space-between",
                    "space-around"
                  ],
                  "description": "Along the direction, for space left over: start (default), center, end, space-between or space-around"
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Arrange what the box holds in a row or column, in file order, instead of by cells: row, column, or a mapping with direction, gap and align"
        },
        "box": {
          "type": "boolean",
          "description": "false: draw no box or title; the group only arranges what it holds"
        },
        "grow": {
          "type": "number",
          "minimum": 0,
          "description": "In a box with layout: this group's share of the space left over (default 0)"
        },
        "behind": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?)$"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Boxes stacked behind this one, nearest first, as id: title; edges can end at them"
        },
        "nodes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?)$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "at": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "Grid cell [col, row]; fractions allowed; default: placed automatically"
              },
              "title": {
                "type": "string"
              },
              "sub": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "Muted text under the title"
              },
              "icon": {
                "type": "string",
                "description": "Icon name from the diagram's icon folders or the core set"
              },
              "tone": {
                "type": "string",
                "description": "Tile colour for generated icons"
              },
              "junction": {
                "type": "boolean",
                "description": "A dot where edges meet (a bus); has no icon or text"
              },
              "align_x": {
                "type": "string",
                "description": "A node to line up with, one above the other: same x"
              },
              "align_y": {
                "type": "string",
                "description": "A node to line up with, side by side: same y"
              },
              "cells": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "description": "Progress cells: a list of names (shown as the caption while active) or a count"
              },
              "stack": {
                "type": "integer",
                "minimum": 1,
                "description": "Draw the icon as a stack of N"
              },
              "mark": {
                "type": "string",
                "enum": [
                  "new",
                  "removed",
                  "changed"
                ]
              },
              "hidden": {
                "type": "boolean",
                "description": "Start hidden; a scenario can show it"
              },
              "tooltip": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "A node: icon, title and sub text, centred on a grid cell"
          },
          "minProperties": 1,
          "description": "Nodes inside this group"
        },
        "groups": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:/[A-Za-z_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)?)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/group"
          },
          "minProperties": 1,
          "description": "Groups inside this group"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "description": "A titled, tinted container around nodes and other groups"
    }
  }
}
